# ── Telegram API Credentials ────────────────────────────────
API_ID=12345678
API_HASH=your_api_hash_here

# ── Bot Token (from @BotFather) ──────────────────────────────
BOT_TOKEN=your_bot_token_here

# ── Owner ─────────────────────────────────────────────────────
OWNER_ID=123456789
OWNER_USERNAME=your_username

# ── Bot Profile ───────────────────────────────────────────────
BOT_USERNAME=YourBotUsername
BOT_NAME=YourBotName

# ── MongoDB ───────────────────────────────────────────────────
MONGO_DB_URI=mongodb+srv://user:pass@cluster.mongodb.net/

# ── Logger Group (optional, but recommended) ─────────────────
# Create a group, add bot as admin, get its ID
LOGGER_ID=-1001234567890

# ── Assistant Session (optional, for voice chat) ──────────────
# Generate via Pyrogram session generator
STRING_SESSION=

# ── Clone Mode (1=enabled, 0=disabled) ───────────────────────
CLONE_MODE=0
CLONE_TOKEN=

# ── YouTube Cookies (optional, for blocked videos) ───────────
# Either a URL to a cookies.txt, OR inline base64 of the Netscape cookie file:
COOKIE_URL=
COOKIE_B64=

# ── YouTube Download API (optional, for fallback) ────────────
API_KEY=local
API_URL=http://localhost:9091
VIDEO_API_URL=http://localhost:9091

# ── Heroku (optional) ────────────────────────────────────────
HEROKU_APP_NAME=
HEROKU_API_KEY=

# ── Duration Limit (in minutes) ──────────────────────────────
DURATION_LIMIT=17000
SONG_DOWNLOAD_DURATION=9999999
SONG_DOWNLOAD_DURATION_LIMIT=9999999

# ── Spotify (optional) ───────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── YouTube API (for fallback search) ────────────────────────
YT_API_KEY=
YTPROXY_URL=https://tgapi.xbitcode.com

# ── nubcoders YT-DLP Wrapper (primary downloader) ────────────
# Get your free personal token at https://api.nubcoders.com
#
# Leave NUB_API_KEY empty to fall back to Shruti / Inflex / yt-dlp.
NUB_API_URL=https://api.nubcoders.com
NUB_API_KEY=

# ── Support Links ────────────────────────────────────────────
SUPPORT_CHANNEL=https://t.me/YourChannel
SUPPORT_CHAT=https://t.me/YourGroup

# ── Public Health URL (Render/Railway for keep-alive) ────────
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
# KEEPALIVE_URL=https://your-app.onrender.com

# ── Third-party API keys (kept in env, NOT hardcoded in source) ──
# Rotate these at their providers if the repo was ever copied publicly.
PHONE_API_KEY=
BG_REMOVE_API_KEY=
WEATHER_API_KEY=
IPINFO_TOKEN=
IPQUALITYSCORE_API_KEY=
TMDB_API_KEY=
GARENA_CLIENT_SECRET=